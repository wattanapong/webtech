<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ?? 'Member' %></title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="flex min-h-screen flex-col bg-slate-50 text-slate-800">
  <main class="m-auto w-full max-w-sm rounded-xl bg-white p-6 shadow">
    <h1 class="text-2xl font-bold">Login (Ex1)</h1>
    <p class="mt-2 text-red-600"><%= locals.msg ? msg : "" %></p>
    <form action="/member/verify" method="post" class="mt-4 space-y-3">
      <input name="username" required placeholder="Username" class="w-full rounded border p-2">
      <input name="password" type="password" required placeholder="Password" class="w-full rounded border p-2">
      <button class="w-full rounded bg-blue-600 py-2 text-white">Login</button>
    </form>
    <p class="mt-4 text-sm text-slate-500">Try test / test, john / 1234, then a wrong password.
      Then open <a class="underline" href="/member/member">/member/member</a> directly.</p>
  </main>
</body>
</html>
