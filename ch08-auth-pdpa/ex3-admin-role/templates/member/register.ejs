<%- include('../partials/header') %>
<main class="m-auto w-full max-w-sm rounded-xl bg-white p-6 shadow">
  <h1 class="text-2xl font-bold">Register</h1>
  <% if (locals.msg) { %><p class="mt-2 rounded bg-red-50 p-2 text-red-600"><%= msg %></p><% } %>
  <form action="/member/register" method="post" class="mt-4 space-y-3">
    <input name="username" required maxlength="100" placeholder="Username" autocomplete="username" value="<%= locals.username ?? '' %>" class="w-full rounded border p-2">
    <input name="password" type="password" required minlength="8" placeholder="Password (8+ characters)" autocomplete="new-password" class="w-full rounded border p-2">
    <input name="confirmPassword" type="password" required minlength="8" placeholder="Confirm password" autocomplete="new-password" class="w-full rounded border p-2">
    <label class="flex gap-2 text-sm">
      <input type="checkbox" name="consent" value="yes" required>
      <span>I have read the <a href="/privacy" class="underline">Privacy Notice</a> and agree.</span>
    </label>
    <button class="w-full rounded bg-blue-600 py-2 text-white hover:bg-blue-700">Register</button>
  </form>
</main>
<%- include('../partials/footer') %>
