<%- include('../partials/header') %>
<main class="mx-auto w-full max-w-4xl p-6">
  <h1 class="text-2xl font-bold">Members</h1>
  <div class="mt-4 overflow-x-auto rounded-xl bg-white shadow">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-100"><tr><th class="p-2">ID</th><th class="p-2">Username</th><th class="p-2">Role</th><th class="p-2">Consent</th><th class="p-2">Status</th><th class="p-2"></th></tr></thead>
      <tbody>
      <% members.forEach(m => { %>
        <tr class="border-t">
          <td class="p-2"><%= m.id %></td>
          <td class="p-2"><%= m.username %></td>
          <td class="p-2"><%= m.role %></td>
          <td class="p-2"><%= m.consent_at ? m.consent_at.toISOString().slice(0, 10) : '-' %></td>
          <td class="p-2"><%= m.active ? 'active' : 'disabled' %></td>
          <td class="p-2">
            <% if (m.id !== user.id) { %>
            <form action="/member/admin/<%= m.id %>/toggle" method="post">
              <button class="rounded px-2 py-1 <%= m.active ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %>"><%= m.active ? 'Disable' : 'Enable' %></button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</main>
<%- include('../partials/footer') %>
