<%- include('partials/head') %>
<main class="mx-auto max-w-5xl space-y-4 p-6">
  <h1 class="text-2xl font-bold">Customers (<span id="total"><%= total %></span>)</h1>

  <div class="flex flex-wrap items-center gap-3">
    <input id="search" type="search" placeholder="Live search by name (debounce 300 ms)"
           class="min-w-60 flex-1 rounded border px-3 py-2 dark:bg-gray-800">
    <label class="text-sm">Rows
      <select id="limit" class="rounded border px-2 py-1 dark:bg-gray-800">
        <option <%= limit === 5 ? 'selected' : '' %>>5</option>
        <option <%= limit === 10 ? 'selected' : '' %>>10</option>
        <option <%= limit === 20 ? 'selected' : '' %>>20</option>
      </select>
    </label>
  </div>

  <p id="status" class="text-sm text-gray-500" aria-live="polite"></p>

  <div class="overflow-x-auto rounded-xl shadow">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-100 dark:bg-gray-800">
        <tr><th class="p-2">#</th><th class="p-2">Name</th><th class="p-2">Phone</th><th class="p-2">City</th><th class="p-2">Country</th><th class="p-2 text-right">Credit</th></tr>
      </thead>
      <tbody id="tableBody">
        <%# first page rendered on the server (SSR); later pages come from fetch (CSR) %>
        <% rows.forEach(c => { %>
          <tr class="border-t dark:border-gray-700">
            <td class="p-2"><%= c.customerNumber %></td><td class="p-2"><%= c.customerName %></td><td class="p-2"><%= c.phone %></td>
            <td class="p-2"><%= c.city %></td><td class="p-2"><%= c.country %></td><td class="p-2 text-right"><%= c.creditLimit %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div id="pager" class="flex items-center gap-3">
    <button id="prev" class="rounded border px-3 py-1 disabled:opacity-40" disabled>← Prev</button>
    <span id="pageInfo" class="text-sm">Page 1</span>
    <button id="next" class="rounded border px-3 py-1 disabled:opacity-40">Next →</button>
  </div>

  <details class="rounded border p-4">
    <summary class="cursor-pointer font-semibold">Add a customer (fetch POST JSON)</summary>
    <form id="addForm" class="mt-3 grid gap-2 sm:grid-cols-4">
      <input name="customerName" required placeholder="Name" class="rounded border px-2 py-1 dark:bg-gray-800">
      <input name="phone" required placeholder="Phone" class="rounded border px-2 py-1 dark:bg-gray-800">
      <input name="city" required placeholder="City" value="Phayao" class="rounded border px-2 py-1 dark:bg-gray-800">
      <input name="country" required placeholder="Country" value="Thailand" class="rounded border px-2 py-1 dark:bg-gray-800">
      <button class="rounded bg-blue-600 py-1 text-white sm:col-span-4">Add</button>
    </form>
  </details>
</main>
<script src="/js/customers.js" type="module"></script>
<%- include('partials/foot') %>
