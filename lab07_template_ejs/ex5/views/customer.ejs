<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
</head>
<body>
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-primary text-white text-center py-3">
                        <h1 class="h3 mb-0">โปรไฟล์ลูกค้า</h1>
                    </div>
    
                    <div class="card-body p-4">
    
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <p class="mb-1 text-muted small">ชื่อลูกค้า</p>
                                <h2 class="h5 text-primary"><%= customer.customerName %></h2>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-1 text-muted small">รหัสลูกค้า</p>
                                <h2 class="h5"><%= customer.customerNumber %></h2>
                            </div>
                        </div>
    
                        <hr>
    
                        <div class="row">
                            <div class="col-lg-6 border-end">
                                <h4 class="h5 mb-3 text-secondary">ข้อมูลติดต่อและที่อยู่</h4>
                                
                                <div class="mb-2">
                                    <label class="form-label fw-bold small">โทรศัพท์:</label>
                                    <p class="form-control-plaintext"><%= customer.phone %></p>
                                </div>
    
                                <div class="mb-2">
                                    <label class="form-label fw-bold small">ที่อยู่บรรทัดที่ 1:</label>
                                    <p class="form-control-plaintext"><%= customer.addressLine1 %></p>
                                </div>
    
                                <% if (customer.addressLine2) { %>
                                <div class="mb-2">
                                    <label class="form-label fw-bold small">ที่อยู่บรรทัดที่ 2:</label>
                                    <p class="form-control-plaintext"><%= customer.addressLine2 %></p>
                                </div>
                                <% } %>
    
                                <div class="row">
                                    <div class="col-4">
                                        <label class="form-label fw-bold small">เมือง:</label>
                                        <p class="form-control-plaintext"><%= customer.city %></p>
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label fw-bold small">รัฐ/จังหวัด:</label>
                                        <p class="form-control-plaintext"><%= customer.state %></p>
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label fw-bold small">รหัสไปรษณีย์:</label>
                                        <p class="form-control-plaintext"><%= customer.postalCode %></p>
                                    </div>
                                </div>
                                
                                <div class="mb-2">
                                    <label class="form-label fw-bold small">ประเทศ:</label>
                                    <p class="form-control-plaintext"><%= customer.country %></p>
                                </div>
                            </div>
    
                            <div class="col-lg-6 ps-lg-4">
                                <h4 class="h5 mb-3 text-secondary">ข้อมูลการเงินและการขาย</h4>
                                
                                <div class="mb-2">
                                    <label class="form-label fw-bold small">วงเงินเครดิต:</label>
                                    <p class="form-control-plaintext
</body>
</html>