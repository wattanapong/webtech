<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
</head>
<body>
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th scope="col">Order Number</th>
                <th scope="col">Customer Number</th>
                <th scope="col">Order Date</th>
                <th scope="col">Required Date</th>
                <th scope="col">Shipped Date</th>
                <th scope="col">Status</th>
                <th scope="col">Comments</th>
            </tr>
        </thead>
        <tbody class="table-group-divider">
            <% orders.forEach(order => { %>
                <tr>
                    <td><a href="/orderdetails/<%= order.orderNumber %>"><%= order.orderNumber %></a></td>
                    <td><%= order.customerNumber %></td>
                    <td><%= new Date(order.orderDate).toLocaleDateString('TH-th') %></td>
                    <td><%= new Date(order.requiredDate).toLocaleDateString('TH-th') %></td>
                    <td><%= new Date(order.shippedDate).toLocaleDateString('TH-th') %></td>
                    <td><%= order.status %></td>
                    <td><%= order.comments %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>