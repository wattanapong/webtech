<%- include('partials/header') %>
<main class="mx-auto max-w-5xl p-6">
  <h1 class="text-2xl font-bold">Order #<%= orderNumber %></h1>
  <div class="mt-4 overflow-x-auto rounded-xl bg-white shadow">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-100"><tr><th class="p-2">Code</th><th class="p-2">Product</th><th class="p-2 text-right">Qty</th><th class="p-2 text-right">Price each</th></tr></thead>
      <tbody>
      <% orderdetails.forEach(d => { %>
        <tr class="border-t">
          <td class="p-2"><%= d.productCode %></td>
          <td class="p-2"><%= d.productName %></td>
          <td class="p-2 text-right"><%= d.quantityOrdered %></td>
          <td class="p-2 text-right"><%= d.priceEach %></td>
        </tr>
      <% }) %>
      </tbody>
      <%# Homework 1: add a <tfoot> row with the total quantity and the total price of this order %>
    </table>
  </div>
</main>
<%- include('partials/footer') %>
