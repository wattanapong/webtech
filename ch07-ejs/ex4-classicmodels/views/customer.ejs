<%- include('partials/header') %>
<main class="mx-auto max-w-5xl p-6">
  <a href="/customers" class="text-sm text-blue-700">← All customers</a>
  <h1 class="mt-2 text-2xl font-bold"><%= customer.customerName %></h1>
  <p class="text-gray-600"><%= customer.contactFirstName %> <%= customer.contactLastName %> · <%= customer.phone %> · <%= customer.city %>, <%= customer.country %></p>
  <h2 class="mt-6 text-xl font-semibold">Orders (<%= orders.length %>)</h2>
  <% if (orders.length === 0) { %>
    <p class="mt-2">No orders yet.</p>
  <% } else { %>
    <ul class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      <% orders.forEach(o => { %>
        <li class="rounded-xl bg-white p-4 shadow">
          <a class="font-semibold text-blue-700" href="/orders/<%= o.orderNumber %>">Order #<%= o.orderNumber %></a>
          <p class="text-sm text-gray-500"><%= o.orderDate.toISOString().slice(0, 10) %> · <%= o.status %></p>
        </li>
      <% }) %>
    </ul>
  <% } %>
</main>
<%- include('partials/footer') %>
