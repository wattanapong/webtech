<%- include('partials/header') %>
<main class="mx-auto max-w-5xl p-6">
  <h1 class="text-2xl font-bold"><%= title %> (<%= customers.length %>)</h1>
  <div class="mt-4 overflow-x-auto rounded-xl bg-white shadow">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-100"><tr><th class="p-2">#</th><th class="p-2">Name</th><th class="p-2">City</th><th class="p-2">Country</th></tr></thead>
      <tbody>
      <% customers.forEach(c => { %>
        <tr class="border-t hover:bg-blue-50">
          <td class="p-2"><%= c.customerNumber %></td>
          <td class="p-2"><a class="text-blue-700 underline" href="/customers/<%= c.customerNumber %>"><%= c.customerName %></a></td>
          <td class="p-2"><%= c.city %></td>
          <td class="p-2"><%= c.country %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</main>
<%- include('partials/footer') %>
