<%- include('../partials/header') %>
<main class="mx-auto max-w-md p-6">
  <h1 class="mb-4 text-2xl font-bold">Edit item #<%= item.id %></h1>
  <% if (locals.error) { %>
    <p class="mb-2 rounded bg-red-50 p-2 text-red-600"><%= error %></p>
  <% } %>
  <form action="/items/<%= item.id %>/edit" method="post" class="space-y-3">
    <label class="block"><span class="text-sm font-medium">Name</span>
      <input name="name" required maxlength="100" value="<%= locals.item?.name ?? '' %>" class="mt-1 w-full rounded border p-2"></label>
    <label class="block"><span class="text-sm font-medium">Price (฿)</span>
      <input name="price" type="number" step="0.01" min="0" required value="<%= locals.item?.price ?? '' %>" class="mt-1 w-full rounded border p-2"></label>
    <button class="rounded bg-blue-600 px-4 py-2 text-white">Save</button>
    <a href="/items" class="ml-2 text-gray-600">Cancel</a>
  </form>
</main>
<%- include('../partials/footer') %>
