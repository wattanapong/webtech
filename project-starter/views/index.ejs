<%- include('partials/header') %>
<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
  <section class="grid items-center gap-8 md:grid-cols-2">
    <div>
      <h1 class="text-3xl font-bold md:text-5xl">Your project title</h1>
      <p class="mt-4 text-slate-600 dark:text-slate-300">One sentence: what problem does the system solve?</p>
      <div class="mt-6 flex gap-3">
        <% if (locals.user) { %>
          <a href="/items" class="btn btn-primary">Go to my items</a>
        <% } else { %>
          <a href="/member/register" class="btn btn-primary">Get started</a>
          <a href="/member/login" class="btn border border-brand-600 text-brand-600">Log in</a>
        <% } %>
      </div>
    </div>
    <img src="/img/logo.png" alt="Project logo" width="240" height="120" class="mx-auto w-48">
  </section>
</main>
<%- include('partials/footer') %>
