<header class="bg-white shadow dark:bg-slate-800">
  <nav class="mx-auto flex max-w-5xl flex-wrap items-center gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2 text-xl font-bold text-brand-600"><img src="/img/logo.png" alt="" width="64" height="32"> MyProject</a>
    <button id="menu-btn" class="ml-auto md:hidden" aria-label="Open menu" aria-controls="menu">☰</button>
    <ul id="menu" class="hidden w-full flex-col gap-2 md:ml-auto md:flex md:w-auto md:flex-row md:items-center md:gap-6">
      <% if (locals.user) { %>
        <li><a href="/items" class="hover:text-brand-600">My items</a></li>
        <% if (user.role === 'admin') { %><li><a href="/member/admin" class="hover:text-brand-600">Admin</a></li><% } %>
        <li><a href="/member/member" class="hover:text-brand-600"><%= user.username %></a></li>
        <li><form action="/member/logout" method="post"><button class="hover:text-brand-600">Logout</button></form></li>
      <% } else { %>
        <li><a href="/member/login" class="hover:text-brand-600">Login</a></li>
        <li><a href="/member/register" class="btn btn-primary">Register</a></li>
      <% } %>
      <li><button id="themeBtn" class="rounded border px-2 py-1 text-sm" aria-label="Toggle dark mode">🌓</button></li>
    </ul>
  </nav>
</header>
