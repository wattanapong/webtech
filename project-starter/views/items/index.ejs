<%- include('../partials/header') %>
<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold"><%= title %></h1>
    <a href="/items/new" class="btn btn-primary">+ New item</a>
  </div>
  <input id="search" type="search" placeholder="Search (AJAX, CH9)" class="input mt-4">
  <p id="status" class="mt-2 text-sm text-slate-500"></p>
  <div id="items" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% if (items.length === 0) { %><p>No items yet.</p><% } %>
    <% items.forEach(item => { %>
      <article class="card">
        <h2 class="font-semibold"><%= item.name %></h2>
        <p class="text-sm text-slate-500"><%= Number(item.price).toFixed(2) %> ฿</p>
        <div class="mt-3 flex gap-3 text-sm">
          <a href="/items/<%= item.id %>/edit" class="text-brand-600">Edit</a>
          <form action="/items/<%= item.id %>/delete" method="post" class="confirm-delete">
            <button class="text-red-600">Delete</button>
          </form>
        </div>
      </article>
    <% }) %>
  </div>
</main>
<%- include('../partials/footer') %>
