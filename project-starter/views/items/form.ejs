<%- include('../partials/header') %>
<main class="mx-auto w-full max-w-md flex-1 px-4 py-8">
  <div class="card">
    <h1 class="text-2xl font-bold"><%= title %></h1>
    <% if (locals.error) { %><p class="mt-2 rounded bg-red-50 p-2 text-red-600"><%= error %></p><% } %>
    <form action="<%= action %>" method="post" class="mt-4 space-y-3">
      <label class="block"><span class="text-sm font-medium">Name</span>
        <input name="name" required maxlength="100" value="<%= locals.item?.name ?? '' %>" class="input"></label>
      <label class="block"><span class="text-sm font-medium">Price (฿)</span>
        <input name="price" type="number" min="0" step="0.01" required value="<%= locals.item?.price ?? '' %>" class="input"></label>
      <button class="btn btn-primary">Save</button>
      <a href="/items" class="ml-2 text-slate-500">Cancel</a>
    </form>
  </div>
</main>
<%- include('../partials/footer') %>
